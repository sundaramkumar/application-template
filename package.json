{
  "name": "application",
  "private": true,
  "workspaces": [
    "application/backend",
    "application/frontend",
    "application/shared"
  ],
  "scripts": {
    "dev:backend": "cd application/backend  && bun run dev",
    "dev:frontend": "cd application/frontend && bun run dev",
    "dev": "bun run dev:backend & bun run dev:frontend",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '*' build",
    "lint": "bun run --filter '*' lint",
    "db:generate": "cd application/backend && bun run db:generate",
    "db:migrate": "cd application/backend && bun run db:migrate",
    "seed": "cd application/backend && bun run seed",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.9"
  }
}
