# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/application

# Auth — JWT signing secret (must be at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Server
PORT=3005
FRONTEND_URL=http://localhost:5175
NODE_ENV=development
DB_POOL_MAX=10
