    "test:billing": "playwright test --grep @billing",
    "test:crud": "playwright test --grep @crud",
    "test:auth": "playwright test --grep @auth",
    "test:settings": "playwright test --grep @settings",
    "test:conversion": "playwright test --grep @conversion"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
