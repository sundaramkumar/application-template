    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-virtual": "^3.13.24",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-grid-layout": "^1.4.4",
    "react-hook-form": "^7.79.0",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
